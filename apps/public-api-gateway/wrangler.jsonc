{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"ledgerflow-public-reference-gateway",
  "main":"src/worker.ts",
  "compatibility_date":"2026-10-16",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "observability":{"enabled":false},
  "assets":{"directory":"../web/dist","binding":"WEB_ASSETS","run_worker_first":["/api/*","/v1/*","/mcp","/mcp/*","/oauth/*","/.well-known/*","/health"]},
  "vars":{"REMOTE_ENABLED":"false","REMOTE_ORIGIN":"https://ledgerflow-public-reference-gateway.eric5833.workers.dev"},
  "ratelimits":[
    {"name":"REFERENCE_RATE_LIMITER","namespace_id":"1001","simple":{"limit":30,"period":60}},
    {"name":"REMOTE_RATE_LIMITER","namespace_id":"1002","simple":{"limit":120,"period":60}},
    {"name":"AUTH_RATE_LIMITER","namespace_id":"1003","simple":{"limit":20,"period":60}}
  ]
}
