{
  "name": "ledgerflow-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "pnpm web:build && tsx scripts/start-local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/integration",
    "env:check": "tsx scripts/check-env.ts",
    "supabase:check": "tsx scripts/check-supabase.ts",
    "supabase:init": "tsx scripts/initialize-supabase.ts",
    "api:check": "tsx scripts/check-public-apis.ts",
    "api:adapters": "tsx scripts/check-public-adapters.ts",
    "env:import": "tsx scripts/import-api-keys.ts",
    "seed:mini": "tsx scripts/seed-mini.ts",
    "seed:full": "tsx scripts/seed-full.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:full": "tsx scripts/demo-full.ts",
    "demo:services": "tsx scripts/demo-services.ts",
    "mcp:start": "tsx apps/mcp-server/src/main.ts",
    "mcp:stdio": "tsx apps/mcp-server/src/main.ts --stdio",
    "mcp:catalog": "tsx scripts/export-mcp-catalog.ts",
    "mcp:examples": "tsx scripts/export-mcp-examples.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "mcp:doctor": "tsx scripts/check-connections.ts",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "session:key": "tsx scripts/init-session-key.ts",
    "container:smoke": "tsx scripts/container-smoke.ts",
    "web:build": "pnpm --filter @ledgerflow/web build",
    "web:dev": "pnpm --filter @ledgerflow/web dev",
    "evaluate": "tsx scripts/evaluate-accounting.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@ledgerflow/accounting-core": "workspace:*",
    "@ledgerflow/application-services": "workspace:*",
    "@ledgerflow/contracts": "workspace:*",
    "@ledgerflow/data-access": "workspace:*",
    "@ledgerflow/mcp-server": "workspace:*",
    "@ledgerflow/public-data": "workspace:*",
    "@ledgerflow/test-data": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.1",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "yaml": "2.8.2"
  }
}
