# Server-only settings. Copy to .env.local; never commit actual values.
# ERP demos do not call public APIs. api:check explicitly performs live probes.
ADAPTER_MODE=mock

# Public-data providers: use the issued authentication value, not the portal login.
NTS_SERVICE_KEY=
DART_API_KEY=
LAW_OC=
ECOS_API_KEY=

# Human Auth + private evidence Storage; actual project verification required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# MCP default demo shares one temporary PostgreSQL with both AI clients.
LEDGERFLOW_MCP_PORT=8787
LEDGERFLOW_MCP_MODE=demo
# Optional bearer authentication for MCP. Server stays bound to localhost.
LEDGERFLOW_MCP_TOKEN=
# Optional existing PostgreSQL profile; never auto-migrates or seeds this DB.
LEDGERFLOW_DATABASE_URL=
# Optional downloaded Supabase root CA (.crt/.cer/.pem), kept in ignored .ledgerflow/certs.
# Hosted connections always verify TLS; never set rejectUnauthorized=false.
LEDGERFLOW_DATABASE_CA_FILE=
LEDGERFLOW_USER_ID=
LEDGERFLOW_COMPANY_ID=

# Optional external-JWT web-session persistence. Keep demo on memory.
# postgres requires migration 006, external Auth, and one stable server-only key.
LEDGERFLOW_HUMAN_SESSION_STORE=memory
# Canonical base64 of 32 cryptographically random bytes. Never print or commit.
LEDGERFLOW_SESSION_ENCRYPTION_KEY=
